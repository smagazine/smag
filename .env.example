# Admin CMS credentials. Copy to .env.local and set real values before deploying.
# Without these, the CMS falls back to insecure dev defaults (password "admin").
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SECRET=change-me-to-a-long-random-string
# Secret for the scheduled-publish cron (/api/cron/publish, see vercel.json).
# Vercel sets this automatically when you add it as an env var; without it the
# cron route rejects every unauthenticated request.
CRON_SECRET=change-me-to-a-long-random-string

# Firebase — the only backend this app talks to: Firestore for all article/
# sponsor/comment/user/etc. data, Cloud Storage for uploaded images/videos.
# Create a service account in the Firebase console under Project settings >
# Service accounts > Generate new private key, then fill these in from the
# downloaded JSON. Without these, everything falls back to the local
# filesystem (data/*.json, public/uploads/) under `npm run dev` only — a
# real deploy always needs Firebase configured.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value from the service-account JSON as-is, including
# the literal \n sequences and the BEGIN/END lines, wrapped in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
